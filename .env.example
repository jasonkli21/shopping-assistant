ENVIRONMENT=local
AUTH_MODE=local
DATABASE_URL=postgresql+psycopg://shopping:shopping@localhost:5432/shopping
# Use a direct TLS endpoint for release migrations and account binding only.
# MIGRATION_DATABASE_URL=postgresql+psycopg://...?... (set only in protected operator environment)
LOCAL_OWNER_ID=00000000-0000-4000-8000-000000000001
# FIREBASE_PROJECT_ID=... (set outside local mode)
# FIREBASE_OWNER_UID=... (set outside local mode)
# `external` currently fails closed; it does not configure a working transport.
PERSONAL_AI_MODE=fake
CONVERSATION_GENERATION_TIMEOUT_SECONDS=30
CONVERSATION_MAX_CONCURRENT_GENERATIONS=4
SEARCH_PROVIDER=fake
TAVILY_API_KEY=
BRAVE_API_KEY=
CORS_ORIGINS=http://localhost:5173
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
RESEARCH_MAX_QUERIES=8
RESEARCH_MAX_CANDIDATES=20
RESEARCH_MAX_RESULTS=60
RESEARCH_MAX_RESULTS_PER_QUERY=10
RESEARCH_MAX_ATTEMPTS=8
RESEARCH_DEADLINE_SECONDS=60
RESEARCH_PROVIDER_TIMEOUT_SECONDS=15
RESEARCH_MAX_CONCURRENT_SEARCHES=1
RESEARCH_MAX_CONCURRENT_RUNS=2
